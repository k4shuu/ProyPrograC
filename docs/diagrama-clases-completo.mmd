classDiagram
direction LR

namespace naves {
  class Nave {
    <<abstract>>
    #String identidad
    #int combustible
    #int energia
    #int desgaste
    #int gemas
    #boolean destruida
    +estaViva() boolean
    +usarEnergia(int)
    +cargarComb(int)
    +cargarEnerg(int)
    +usarCombustible(int)
    +realizarDesgaste(int)
    +mantenimiento()
    +agregarTripulante(Tripulante)
    +calcularTotalHaberes() double
  }
  class NaveExploradora
  class NaveCarguero
  class NaveCombate
  class NaveFactory {
    <<Factory>>
    +crearNave(String, String, int, int, int)$ Nave
  }
}

namespace tripulacion {
  class Tripulante {
    <<abstract>>
    #String identidad
    #int antiguedad
    +getInfo()* String
    +getSueldo()* double
    +getConceptoSueldo()* String
  }
  class Cargo {
    <<abstract>>
  }
  class Capitan
  class Consejero {
    -int cantConsejos
  }
  class Alferez
  class Teniente
  class DecoratorOrigen {
    <<abstract>>
    <<Decorator>>
    #Tripulante tripulante
  }
  class Vulcano
  class Terricola
  class Marciano
  class CargoFactory {
    <<Factory>>
    +crear(String, String, int, int)$ Cargo
  }
  class OrigenFactory {
    <<Factory>>
    +crear(Tripulante, String)$ DecoratorOrigen
  }
}

namespace misiones {
  class Mision {
    <<abstract>>
    #String cod
    #int combConsumido
    #int energCargada
    #int desgaste
    #Posicion obj
    #Estado estado
    +Resultado result
    +comenzar() InformeMision
    +preparar()
    +ejecutar()
    +evaluar()
    +cerrar() InformeMision
    #aplicarResultadoExitoso()*
  }
  class MisionIntercep
  class MisionRecolec
  class MisionRetorno
  class MisionFactory {
    <<Factory>>
    +crearMision(String, AsistenteComando)$ Mision
  }
  class InformeMision {
    -String cod
    -Resultado result
    -Estado lastState
    -int balanceCombustible
    -int balanceEnergia
    -int balanceDesgaste
    -int balanceGemas
    +finalizar(Nave, Resultado, Estado)
    +actualizarBalances(Nave)
  }
  class Estado {
    <<enumeration>>
    CREADA
    PREPARADA
    EJECUTADA
    EVALUADA
    CERRADA
  }
  class ResultadoMisiones["Resultado"] {
    <<enumeration>>
    EXITOSA
    FALLIDA
    CANCELADA
  }
}

namespace warp {
  class MotorWarp {
    <<Context>>
    -EstadoWarp estadoActual
    -Nave nave
    +ejecutarSaltoComun()
    +ejecutarSaltoWarp()
    +setEstado(EstadoWarp)
  }
  class EstadoWarp {
    <<interface>>
    <<State>>
    +ejecutarSaltoComun()
    +ejecutarSaltoWarp()
    +getNombreEstado() String
  }
  class EstadoDisponible
  class EstadoPreparandoSalto
  class EstadoEnWarp
  class EstadoEnfriamiento
}

namespace destinoytablero {
  class ElementoDelUniverso {
    <<interface>>
    +interactuar(Nave)
  }
  class Posicion {
    -int x
    -int y
  }
  class Tablero {
    -int x
    -int y
    -ArrayList~ElementoDelUniverso~ elementos
    -HashMap~Posicion, ElementoDelUniverso~ ocupacion
    -Posicion posicionNave
    -Posicion objetivo
    +moverNave(Posicion)
    +inspeccionarPosicion() ElementoDelUniverso
    +observarAlrededores() ElementoDelUniverso[][]
    +obtenerObjetivo() Posicion
    +calcularRuta(Posicion, Posicion) List~Posicion~
  }
  class Destino {
    <<Singleton>>
    -Destino instance$
    -Tablero tablero
    +init(Tablero)$ Destino
    +getInstance()$ Destino
    +turnoDestino()
  }
  class ObservableTab["Observable"] {
    <<abstract>>
    -ArrayList~Observador~ observadores
    +agregarObservador(Observador)
    +quitarObservador(Observador)
    +notificarObservadores()
  }
  class ObservadorTab["Observador"] {
    <<interface>>
    +actualizar()
  }
}

namespace elementos {
  class Asteroide
  class EstacionesDeCarga
}

namespace asistente {
  class AsistenteComando {
    -Bitacora bitacora
    -Nave nave
    -Tablero tablero
    -RadarLargoAlcance radarLA
    -RadarCortoAlcance radarCA
    -List~Posicion~ ruta
    +escribirBitacora(String, String)
    +solicitarEjecucionSaltoComun()
    +solicitarEjecucionSaltoWarp()
    +calcRuta(Posicion)
  }
  class RadarCortoAlcance {
    -Tablero tablero
    +analizarPasoSig(List~Posicion~) ElementoDelUniverso
  }
  class RadarLargoAlcance {
    -Tablero tablero
    +calcRuta(Posicion) List~Posicion~
  }
}

namespace bitacora {
  class Bitacora {
    -List~Entrada~ entradas
    +registrar(String, String)
    +registrar(Entrada)
    +mostrarBitacora() List~String~
    +getHistorialBitacora() String
    +limpiar()
  }
  class Entrada {
    -LocalDateTime fechaHora
    -String mensaje
    -String origen
  }
}

namespace persistencia {
  class ConexionBD {
    -String URL$
    +conectar()$ Connection
  }
  class UsuarioDAO {
    <<DAO>>
    +registrarUsuario(UsuarioDTO) boolean
    +validarCredenciales(String, String) UsuarioDTO
  }
  class UsuarioDTO {
    -String username
    -String password
  }
}

namespace concurrencia {
  class PlataformaDeCarga {
    -ArrayList~Bateria~ baterias
    -int limite
    +depositar(GeneradoraDeEnergia, Bateria)
    +consumir(NaveConsumidora)
  }
  class Bateria
  class GeneradoraDeEnergia {
    -String nombre
    -PlataformaDeCarga plataforma
    +crearBateria() Bateria
    +run()
  }
  class NaveConsumidora {
    -String nombre
    -PlataformaDeCarga plataforma
    +run()
  }
  class ObservableConcurrencia["Observable"] {
    <<abstract>>
    -ArrayList~Observador~ observadores
    +agregarObservador(Observador)
    +quitarObservador(Observador)
    +notificarObservadores(String)
  }
  class ObservadorConcurrencia["Observador"] {
    <<interface>>
    +actualizar(String)
  }
  class IVistaConcurrencia {
    <<interface>>
    +setActionListener(ActionListener)
    +registrarEvento(String)
  }
  class VistaConcurrencia
  class ControladorConcurrencia {
    -IVistaConcurrencia vista
    -ArrayList~GeneradoraDeEnergia~ generadores
    -ArrayList~NaveConsumidora~ naves
    -PlataformaDeCarga plataforma
    +crearNave()
    +crearGenerador()
  }
}

namespace excepciones {
  class CantidadDeElementosSuperaCasillaException {
    <<exception>>
    -int cantidadMaxima
  }
  class CredencialesInvalidasException {
    <<exception>>
  }
  class DimensionesDeTableroInconsistentesException {
    <<exception>>
  }
  class ExcesoCombException {
    <<exception>>
    -int combAct
