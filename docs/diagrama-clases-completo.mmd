    -int combustibleDisponible
  }
  class FaltaEnergiaException {
    <<exception>>
    -int energiaRequerida
    -int energiaDisponible
  }
  class NaveDestruidaException {
    <<exception>>
  }
  class TipoCargoInvalidoException {
    <<exception>>
    -String tipo
  }
  class TipoMisionInvalidaException {
    <<exception>>
    -String tipo
  }
  class TipoOrigenInvalidoException {
    <<exception>>
    -String tipo
  }
  class TransicionMotorInvalidaException {
    <<exception>>
    -String estadoOrigen
    -String estadoDestino
  }
}

namespace MVC {
  class IVista {
    <<interface>>
    +setVisible(boolean)
    +setControlador(ActionListener)
  }
  class VistaPrincipal {
    -Tablero tablero
    -Nave nave
    -Bitacora bitacora
    -AsistenteComando asistente
    +actualizar()
    +mostrarCamino(List~Posicion~)
    +mostrarMisionActual(String)
  }
  class ControladorTablero
  class IObservable {
    <<interface>>
    +agregarObservador(IObservador)
    +notificarObservadores()
  }
  class IObservador {
    <<interface>>
    +actualizar()
  }
  class RecursosYBitacora {
    -List~IObservador~ observadores
    -Nave nave
    -Bitacora bitacora
    -String estadoTablero
    +forzarActualizacionVista()
    +setEstadoTablero(String)
  }
  class IVistaMision {
    <<interface>>
    +setControlador(ActionListener)
    +getCodigoMisionSeleccionada() String
    +mostrarMensaje(String)
  }
  class VistaMision
  class VistaGameOver {
    +mostrarInforme(InformeMision)
    +setControlador(ActionListener)
  }
  class ControladorMision
  class EjecutorMision {
    -Mision mision
    -VistaGameOver vistaGameOver
    +run()
  }
  class VistaLogin
  class ControladorLogin
}

namespace Vista {
  class IVistaLogin {
    <<interface>>
    +getUsuario() String
    +getPassword() String
    +mostrarMensaje(String)
    +cerrarVentana()
  }
  class IVistaCreacion {
    <<interface>>
    +getNombreNave() String
    +getTipoNaveSeleccionada() String
    +getNombreNuevoTripulante() String
    +getOrigenNuevoTripulante() String
    +getCargoNuevoTripulante() String
  }
  class VistaCreacionNaveTripulacion
}

namespace Controlador {
  class ControladorCreacion {
    -IVistaCreacion vista
    -Nave nave
    +crearTripulante()
    +crearNave()
  }
}

%% Herencia e implementacion
ElementoDelUniverso <|.. Nave
Nave <|-- NaveExploradora
Nave <|-- NaveCarguero
Nave <|-- NaveCombate

Tripulante <|-- Cargo
Cargo <|-- Capitan
Cargo <|-- Consejero
Cargo <|-- Alferez
Cargo <|-- Teniente
Tripulante <|-- DecoratorOrigen
DecoratorOrigen <|-- Vulcano
DecoratorOrigen <|-- Terricola
DecoratorOrigen <|-- Marciano

Mision <|-- MisionIntercep
Mision <|-- MisionRecolec
Mision <|-- MisionRetorno

EstadoWarp <|.. EstadoDisponible
EstadoWarp <|.. EstadoPreparandoSalto
EstadoWarp <|.. EstadoEnWarp
EstadoWarp <|.. EstadoEnfriamiento

ObservableTab <|-- Tablero
ElementoDelUniverso <|.. Asteroide
ElementoDelUniverso <|.. EstacionesDeCarga

IVista <|.. VistaPrincipal
ObservadorTab <|.. VistaPrincipal
IObservable <|.. RecursosYBitacora
IVistaMision <|.. VistaMision
IVistaLogin <|.. VistaLogin
IVistaCreacion <|.. VistaCreacionNaveTripulacion

ObservableConcurrencia <|-- PlataformaDeCarga
ObservadorConcurrencia <|-- IVistaConcurrencia
IVistaConcurrencia <|.. VistaConcurrencia

%% Composicion y agregacion
Nave "1" *-- "1" MotorWarp : motorWarp
Nave "1" o-- "0..*" Tripulante : tripulacion
DecoratorOrigen "1" o-- "1" Tripulante : tripulante
Mision "1" *-- "0..1" InformeMision : informe
Tablero "1" o-- "0..*" ElementoDelUniverso : elementos
Tablero "1" *-- "1..2" Posicion : posiciones
ObservableTab "1" o-- "0..*" ObservadorTab : observadores
AsistenteComando "1" *-- "1" RadarCortoAlcance : radarCA
AsistenteComando "1" *-- "1" RadarLargoAlcance : radarLA
Bitacora "1" *-- "0..*" Entrada : entradas
RecursosYBitacora "1" o-- "0..*" IObservador : observadores
PlataformaDeCarga "1" o-- "0..*" Bateria : baterias
ObservableConcurrencia "1" o-- "0..*" ObservadorConcurrencia : observadores
ControladorConcurrencia "1" o-- "0..*" GeneradoraDeEnergia : generadores
ControladorConcurrencia "1" o-- "0..*" NaveConsumidora : naves

%% Asociaciones estructurales
MotorWarp --> EstadoWarp : estadoActual
Mision --> AsistenteComando : asistente
Mision --> Estado : estado
Mision --> ResultadoMisiones : result
Destino --> Tablero : tablero
AsistenteComando --> Nave : nave
AsistenteComando --> Tablero : tablero
AsistenteComando --> Bitacora : bitacora
RadarCortoAlcance --> Tablero : tablero
RadarLargoAlcance --> Tablero : tablero

VistaPrincipal --> Tablero : tablero
VistaPrincipal --> Nave : nave
VistaPrincipal --> Bitacora : bitacora
VistaPrincipal --> AsistenteComando : asistente
ControladorTablero --> VistaPrincipal : vista
RecursosYBitacora --> Nave : nave
RecursosYBitacora --> Bitacora : bitacora
ControladorMision --> IVistaMision : vistaMision
ControladorMision --> AsistenteComando : asistente
EjecutorMision --> Mision : mision
EjecutorMision --> VistaGameOver : vistaGameOver
ControladorLogin --> IVistaLogin : vista
ControladorLogin --> UsuarioDAO : usuarioDAO
ControladorCreacion --> IVistaCreacion : vista
ControladorCreacion --> Nave : nave

GeneradoraDeEnergia --> PlataformaDeCarga : plataforma
NaveConsumidora --> PlataformaDeCarga : plataforma
ControladorConcurrencia --> IVistaConcurrencia : vista
ControladorConcurrencia --> PlataformaDeCarga : plataforma

%% Dependencias de creacion y patrones Factory
NaveFactory ..> Nave : crea
CargoFactory ..> Cargo : crea
OrigenFactory ..> DecoratorOrigen : crea
MisionFactory ..> Mision : crea
ControladorMision ..> EjecutorMision : crea
ControladorMision ..> ControladorLogin : crea
ControladorLogin ..> VistaCreacionNaveTripulacion : crea

%% Dependencias de uso sin relacion estructural equivalente
UsuarioDAO ..> ConexionBD : usa
UsuarioDAO ..> UsuarioDTO : mapea
ControladorCreacion ..> NaveFactory : usa
ControladorCreacion ..> CargoFactory : usa
ControladorCreacion ..> OrigenFactory : usa
ControladorMision ..> MisionFactory : usa
